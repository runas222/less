{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug Nuxt Client",
      "runtimeExecutable": "nuxt",
      "runtimeArgs": ["dev"],
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "**",
        "!**/node_modules/**"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "outputCapture": "std",
      "trace": true
    },
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach to Nuxt",
      "port": 9229,
      "protocol": "inspector",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "**",
        "!**/node_modules/**"
      ],
      "trace": true
    }
  ]
}
